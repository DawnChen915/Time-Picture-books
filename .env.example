# OpenAI（生成卡通形象和插图）。不填时自动使用占位图，方便本地调试流程。
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium   # low | medium | high
# IMAGE_PROVIDER=openai         # openai | placeholder
# OPENAI_TIMEOUT_MS=240000      # 单张图的超时时间

# 在国内访问 OpenAI 需要代理：填你的代理软件的 HTTP 端口（Clash 常见是 7890）
# HTTPS_PROXY=http://127.0.0.1:7890

# 数据存放目录（家庭形象、绘本），默认 ./.data
# DATA_DIR=
